<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
    <object class="wxMenuBar" name="project_menubar">
        <object class="wxMenu" name="project_file_menu">
            <label>File</label>
            <object class="wxMenuItem" name="wxID_NEW">
                <label>New Project</label>
            </object>
            <object class="wxMenuItem" name="wxID_OPEN">
                <label>Open...</label>
                <accel>Ctrl+O</accel>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="ID_SAVE_PROJECT">
                <label>Save</label>
                <accel>Ctrl+S</accel>
            </object>
            <object class="wxMenuItem" name="ID_SAVE_PROJECT_AS">
                <label>Save As...</label>
                <accel>Shift+Ctrl+S</accel>
            </object>
            <object class="wxMenu" name="project_export_menu">
                <label>Export</label>
                <object class="wxMenuItem" name="ID_HTML_EXPORT">
                    <label>HTML Dashboard...</label>
                </object>
                <object class="wxMenuItem" name="ID_SVG_EXPORT">
                    <label>SVG...</label>
                </object>
                <object class="separator"/>
                <object class="wxMenuItem" name="ID_PDF_EXPORT">
                    <label>PDF...</label>
                </object>
                <object class="wxMenuItem" name="ID_PPTX_EXPORT">
                    <label>PowerPoint...</label>
                </object>
                <object class="wxMenuItem" name="ID_ODP_EXPORT">
                    <label>OpenDocument Presentation...</label>
                </object>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="wxID_PRINT">
                <label>Print...</label>
                <accel>Ctrl+P</accel>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="ID_PROJECT_SETTINGS">
                <label>Project Settings...</label>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="wxID_CLOSE">
                <label>Close</label>
                <accel>Ctrl+W</accel>
            </object>
        </object>
        <object class="wxMenu" name="project_pages_menu">
            <label>Pages</label>
            <object class="wxMenuItem" name="ID_INSERT_PAGE">
                <label>Add...</label>
            </object>
            <object class="wxMenuItem" name="ID_EDIT_PAGE">
                <label>Edit...</label>
            </object>
            <object class="wxMenuItem" name="ID_DELETE_PAGE">
                <label>Delete</label>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="ID_REARRANGE_PAGES">
                <label>Reorder...</label>
            </object>
            <object class="separator"/>
            <object class="wxMenuItem" name="ID_REFRESH_ALL">
                <label>Refresh All</label>
                <accel>F5</accel>
            </object>
            <object class="wxMenuItem" name="ID_AUTO_REFRESH">
                <label>Auto Refresh</label>
                <checkable>1</checkable>
            </object>
        </object>
        <object class="wxMenu" name="project_data_menu">
            <label>Data</label>
            <object class="wxMenu" name="project_datasets_menu">
